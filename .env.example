ARMORIQ_API_KEY=
LLM_API_KEY=
# Smoke scripts (spike/hello.py, scripts/cp2_smoke.py). Not secret.
GFG_MCP_BASE_URL=https://<your-service>.onrender.com
GFG_TELEMETRY_MCP=gfg-telemetry
GFG_OPS_MCP=gfg-ops
ARMORIQ_AGENT_ID=
# Optional shared secrets (must match Render env; never commit real values)
GFG_MCP_TOKEN=
# CP4: the SDK sends these to the ArmorIQ proxy (X-Armoriq-MCP-Auth); the proxy injects
# "Authorization: Bearer <token>" upstream. Same value as GFG_MCP_TOKEN on Render.
ARMORIQ_MCP_GFG_TELEMETRY_AUTH_TYPE=bearer
ARMORIQ_MCP_GFG_TELEMETRY_TOKEN=
ARMORIQ_MCP_GFG_OPS_AUTH_TYPE=bearer
ARMORIQ_MCP_GFG_OPS_TOKEN=
GFG_ADMIN_TOKEN=
# LLM narrator (NVIDIA OpenAI-compatible API). Not secret.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
